% iccc.sty -- local reconstruction of the ICCC author-kit layout
% (AAAI-derived: US letter, two columns, Times 10pt, centred bold
% section headings, author-year citations).  The official author kit
% could not be downloaded in the build environment; if you have the
% course-supplied iccc.sty, drop it into this folder in place of this
% file -- report.tex uses only the standard macro names.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iccc}[2026/11/20 ICCC-style layout (local reconstruction)]

\RequirePackage{times}
\RequirePackage{helvet}
\RequirePackage{courier}
\RequirePackage{natbib}
\setcitestyle{authoryear,round,semicolon,aysep={},yysep={,}}

% ---- page geometry (8.5in x 11in, 7in x 9.25in text block) ----
\setlength\paperwidth{8.5in}
\setlength\paperheight{11in}
\setlength\textwidth{7in}
\setlength\textheight{9.25in}
\setlength\columnsep{0.3125in}
\setlength\oddsidemargin{-0.25in}
\setlength\evensidemargin{-0.25in}
\setlength\topmargin{-0.25in}
\setlength\headheight{0pt}
\setlength\headsep{0pt}
\setlength\footskip{0.4in}
\setlength\parindent{10pt}
\setlength\parskip{0pt}
\pagestyle{empty}
\pdfpagewidth=8.5in
\pdfpageheight=11in
\twocolumn
\sloppy
\flushbottom

% ---- title block ----
\def\maketitle{\par
  \begingroup
    \def\thefootnote{\fnsymbol{footnote}}%
    \twocolumn[\@maketitle]%
  \endgroup
  \thispagestyle{empty}%
  \setcounter{footnote}{0}}
\def\@maketitle{\vbox to 1.9in{%
  \centering
  {\LARGE\bfseries \@title \par}\vskip 0.25in
  {\large\begin{tabular}[t]{c}\@author\end{tabular}\par}%
  \vfil}}

% ---- abstract ----
\renewenvironment{abstract}{%
  \centerline{\bfseries\large Abstract}\vspace{0.4em}%
  \begin{quote}\small}{\end{quote}\par\vspace{0.3em}}

% ---- sectioning ----
\def\section{\@startsection{section}{1}{\z@}%
  {-2.0ex plus -0.5ex minus -0.2ex}{1.0ex plus 0.2ex}%
  {\large\bfseries\centering}}
\def\subsection{\@startsection{subsection}{2}{\z@}%
  {-1.6ex plus -0.4ex minus -0.2ex}{0.6ex plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}
\def\paragraph{\@startsection{paragraph}{4}{\z@}%
  {1.0ex plus 0.3ex}{-0.6em}{\normalsize\bfseries}}
\setcounter{secnumdepth}{0}

% ---- references ----
\renewcommand\bibsection{\section{References}}
\renewcommand\bibfont{\small\raggedright}
\setlength\bibhang{0.25in}
\setlength\bibsep{0.15em}

% ---- captions ----
\long\def\@makecaption#1#2{\vskip 6pt
  \setbox\@tempboxa\hbox{\small #1: #2}%
  \ifdim\wd\@tempboxa>\hsize {\small #1: #2\par}%
  \else\hbox to\hsize{\hfil\box\@tempboxa\hfil}\fi}
\setlength\abovecaptionskip{4pt}
\setlength\belowcaptionskip{0pt}
\endinput
